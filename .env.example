# Contact form email delivery (nodemailer + SMTP, open source).
# Copy to .env.local and fill in. Never commit real credentials
# (.env* is gitignored).
#
# Gmail setup:
#  1. Enable 2-Step Verification on your Google account.
#  2. Create an App Password: Google Account > Security > App passwords.
#  3. Use the 16-character app password below (NOT your login password).
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=lenyeuwaeme@gmail.com
CONTACT_SMTP_PASS=xxxx-xxxx-xxxx-xxxx
CONTACT_TO=lenyeuwaeme@gmail.com
CONTACT_FROM=lenyeuwaeme@gmail.com
